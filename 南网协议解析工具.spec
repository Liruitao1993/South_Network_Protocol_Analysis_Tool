# -*- mode: python ; coding: utf-8 -*-
# 南网协议解析工具 - 单文件 EXE 构建配置
# 包含所有依赖：openpyxl, enhanced_export 等（pandas 已改为可选依赖）
#
# 命名规范：输出 exe 名 = 南网协议解析工具_v{APP_VERSION}_{YYYYMMDDHHMMSS}.exe
# 版本号自动从 main_gui.py 的 APP_VERSION 读取，与窗口标题版本号天然对齐，
# 无需手工同步；时间戳精确到秒，区分同版本多次编译。

import re
from datetime import datetime
from pathlib import Path

_spec_root = Path(SPECPATH)

# 1. 从 main_gui.py 解析 APP_VERSION（唯一版本源）
_app_version = "0.0.0"
try:
    _gui_text = (_spec_root / "main_gui.py").read_text(encoding="utf-8")
    _m = re.search(r'^APP_VERSION\s*=\s*"([^"]+)"', _gui_text, re.M)
    if _m:
        _app_version = _m.group(1)
except Exception:
    pass

_build_ts = datetime.now().strftime("%Y%m%d%H%M%S")
_exe_name = f"南网协议解析工具_v{_app_version}_{_build_ts}"

# 2. 动态生成 Windows 版本信息文件（FileVersion/ProductVersion 与 APP_VERSION 对齐）
_vparts = []
for _p in _app_version.split("."):
    _vparts.append(int(_p) if _p.isdigit() else 0)
_vparts = (_vparts + [0, 0, 0, 0])[:4]
_vtuple = f"({_vparts[0]}, {_vparts[1]}, {_vparts[2]}, {_vparts[3]})"
_vstr = f"{_vparts[0]}.{_vparts[1]}.{_vparts[2]}.{_vparts[3]}"

_version_info_file = _spec_root / "_version_info_gen.txt"
_version_info_file.write_text(
    "# UTF-8 (auto-generated by spec, aligned with main_gui.py APP_VERSION)\n"
    "VSVersionInfo(\n"
    f"  ffi=FixedFileInfo(\n"
    f"    filevers={_vtuple},\n"
    f"    prodvers={_vtuple},\n"
    "    mask=0x3f,\n"
    "    flags=0x0,\n"
    "    OS=0x40004,\n"
    "    fileType=0x1,\n"
    "    subtype=0x0,\n"
    "    date=(0, 0)\n"
    "  ),\n"
    "  kids=[\n"
    "    StringFileInfo(\n"
    "      [\n"
    "      StringTable(\n"
    "        u'080404B0',\n"
    "        [StringStruct(u'CompanyName', u'liruitao'),\n"
    "        StringStruct(u'FileDescription', u'南网协议解析工具'),\n"
    f"        StringStruct(u'FileVersion', u'{_vstr}'),\n"
    "        StringStruct(u'InternalName', u'南网协议解析工具'),\n"
    "        StringStruct(u'LegalCopyright', u'Copyright (C) 2026 liruitao'),\n"
    f"        StringStruct(u'OriginalFilename', u'{_exe_name}.exe'),\n"
    "        StringStruct(u'ProductName', u'南网协议解析工具'),\n"
    f"        StringStruct(u'ProductVersion', u'{_vstr}')])\n"
    "      ]),\n"
    "    VarFileInfo([VarStruct(u'Translation', [2052, 1200])])\n"
    "  ]\n"
    ")\n",
    encoding="utf-8",
)
print(f"==> 构建目标: {_exe_name}.exe (APP_VERSION={_app_version})")

a = Analysis(
    ['main_gui.py'],
    pathex=[SPECPATH],
    binaries=[],
    datas=[
        ('custom_di.json', '.'),
        ('dlt645_di.json', '.'),
        ('gdw_custom_afn.json', '.'),
        ('meter_sim_data.json', '.'),  # 虚拟表（698.45 从站模拟器）档案种子数据
        ('icons', 'icons'),
        ('enhanced_export.py', '.'),  # 增强导出模块
        ('scripts', 'scripts'),  # Python 脚本预处理示例脚本
        # EB 数据标识 645/698 帧生成器：运行时动态 import 的纯逻辑模块
        ('reflex_web/frame_gen_utils.py', '.'),  # build_eb_698_frame / build_dlt698_sa
        ('gdw_eb_di_fields.py', '.'),  # EB_DI_FIELDS / encode_eb_di_data
        ('gdw_eb_di_lookup.py', '.'),  # get_eb_di_lookup
    ],
    hiddenimports=[
        # PySide6 核心模块
        'PySide6.QtCore',
        'PySide6.QtGui',
        'PySide6.QtWidgets',
        'PySide6.QtNetwork',
        # 数据处理依赖
        'openpyxl',
        'openpyxl.cell',
        'openpyxl.styles',
        'openpyxl.utils',
        'openpyxl.workbook',
        'openpyxl.writer.excel',
        'pandas',
        'pandas.core',
        # 项目内部模块
        'enhanced_export',
        'system_integration',
        'system_integration.sys_tray',
        'system_integration.global_hotkey',
        'system_integration.registry_menu',
        'system_integration.single_instance',
        'system_integration.system_settings',
        'system_integration.npp_integration',
        'system_integration.clipboard_monitor',
        'system_integration.parse_prompt_dialog',
        'system_integration.quick_parse_panel',
        'system_integration.acrylic_effect',
        'protocol_parser',
        'plc_rf_parser',
        'hdlc_parser',
        'dlt645_parser',
        'gdw10376_parser',
        'dl_t698_45_parser',
        'csg_new_gen_parser',
        'gw_new_gen_parser',
        'gw_new_gen_cmd_payloads',
        'gw_new_gen_mme_parser',
        'hdc10_parser',
        'hdc10_mme_parser',
        'validator.hdc10_validator',
        'obis_lookup',
        'command_lookup',
        'dlt645_di_lookup',
        'gdw_afn_lookup',
        'auto_updater',  # 自动升级检查（main_gui 函数体内运行时 import）
        'thread_registry',  # QThread 注册中心（main_gui 顶层 import，显式声明保险）
        'proc_stats',  # 状态栏 CPU/内存采样（main_gui 顶层 import，纯标准库，显式声明保险）
        'frame_gen_widget',
        'gdw_eb_di_fields',  # EB 数据标识字段定义（被 frame_gen_widget 静态 import）
        'gdw_eb_di_lookup',  # EB 数据标识查询（被 frame_gen_widget 静态 import）
        'archive_widget',
        'lme_info_entry_parser',  # LME自定义接口解析（dlt645_parser/archive_widget 静态 import，显式声明保险）
        'topology_widget',
        'preset_buttons',
        'test_plan_widget',
        'diff_widget',
        'serial_worker',
        'meter_sim_widget',  # 虚拟表 tab（698.45 从站模拟器）
        'meter_sim',
        'meter_sim.archive',
        'meter_sim.link_layer',
        'meter_sim.response_builder',
        'meter_sim.dynamic_data',
        'meter_sim.engine',
        'gui_utils',
        'frame_diff_engine',
        'lua_script_engine',
        'py_script_engine',  # Python 脚本预处理引擎
        # 可选依赖
        'crcmod',
        'serial',
        'serial.tools',
        'serial.tools.list_ports',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        'PyQt5',
        'PyQt6',
        'matplotlib',
        'scipy',
        'PIL',
        'tkinter',
        '_tkinter',
        'IPython',
        'notebook',
        'jupyter',
        'pytest',
        'unittest',
        # 以下为未使用的库，排除以减小体积
        'sympy',
        'pygments',
        'xlsxwriter',
        'jinja2',
        'cryptography',
        'chardet',
        'mpmath',
        '_pytest',
        # 注意：pandas/numpy 不能被排除，否则批量解析的 Excel/CSV 导出功能会失效
    ],
    noarchive=False,
    optimize=0,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name=_exe_name,
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[
        'vcruntime140.dll',
        'python313.dll',
        'openpyxl',
    ],
    runtime_tmpdir=None,
    console=False,  # GUI 模式，不显示控制台
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon='app_icon.ico',
    version=str(_version_info_file),
)
